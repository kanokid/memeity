{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "memeity",
  "version": "0.1.0",
  "identifier": "com.memeity.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "pane",
        "title": "memeity",
        "width": 750,
        "height": 475,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "maximizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg1NkIxREJCNDNBMjA3RTQKUldUa0I2SkR1eDFyaGNTa2hPMzlpcWtTWHJVbzliTGx3RWFWQUt1V3BZMUtWenZNL2pDOVFYM2EK",
      "endpoints": [
        "https://github.com/purestellenium/memeity/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
